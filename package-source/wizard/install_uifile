[
  {
    "step_title": "OCD Media Root",
    "items": [
      {
        "desc": "OCD requires an explicitly typed media root. Enter an existing DSM shared-folder name (or a share to create). DSM grants the OCD package user read/write access to this share."
      },
      {
        "type": "textfield",
        "desc": "Shared folder",
        "subitems": [
          {
            "key": "wizard_shared_folder_name",
            "desc": "Shared folder name",
            "defaultValue": "TV Shows",
            "validator": {
              "allowBlank": false,
              "regex": {
                "expr": "/^[\\w ._-]+$/",
                "errorText": "Use only letters, numbers, spaces, dots, underscores, and hyphens."
              }
            }
          }
        ]
      },
      {
        "type": "combobox",
        "desc": "Media type",
        "subitems": [
          {
            "key": "wizard_media_type",
            "desc": "This decides parsing, metadata, and naming rules.",
            "defaultValue": "tv",
            "editable": false,
            "mode": "local",
            "displayField": "display",
            "valueField": "value",
            "store": {
              "xtype": "arraystore",
              "fields": ["display", "value"],
              "data": [
                ["Television — Show / Season / SxxExx - Episode Name", "tv"],
                ["Movies — Title (Year)", "movie"],
                ["Music — Artist / Album / Song Title", "music"]
              ]
            }
          }
        ]
      },
      {
        "type": "combobox",
        "desc": "Mutation policy",
        "subitems": [
          {
            "key": "wizard_mode",
            "desc": "Observe is recommended until plans look correct.",
            "defaultValue": "observe",
            "editable": false,
            "mode": "local",
            "displayField": "display",
            "valueField": "value",
            "store": {
              "xtype": "arraystore",
              "fields": ["display", "value"],
              "data": [
                ["Observe only — preview and log plans", "observe"],
                ["Apply — rename automatically after safety checks", "apply"]
              ]
            }
          }
        ]
      },
      {
        "type": "password",
        "desc": "Optional TMDB API Read Access Token",
        "subitems": [
          {
            "key": "wizard_tmdb_bearer",
            "desc": "Required when the selected root is Movies; leave blank for Television or Music.",
            "defaultValue": ""
          }
        ]
      },
      {
        "desc": "Television uses TVmaze. Movies use TMDB. Music uses embedded Artist / Album / Title metadata; track/disc numbers stay in the media tags and are not added to filenames."
      }
    ]
  }
]
