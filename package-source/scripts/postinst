#!/bin/sh
set -eu

STATE_DIR="${SYNOPKG_PKGVAR}/state"
CONFIG_FILE="${STATE_DIR}/config.json"
BOOTSTRAP_FILE="${STATE_DIR}/bootstrap.json"
BIN="${SYNOPKG_PKGDEST}/bin/ocd"

mkdir -p "$STATE_DIR"

if [ -f "$CONFIG_FILE" ]; then
    exit 0
fi

share_name="${wizard_shared_folder_name:-}"
media_type="${wizard_media_type:-}"
mode="${wizard_mode:-observe}"

if [ -z "$share_name" ] || [ -z "$media_type" ]; then
    echo "OCD install wizard did not provide a shared folder and media type." >&2
    exit 1
fi

if [ -n "${wizard_tmdb_bearer:-}" ]; then
    printf '%s' "$wizard_tmdb_bearer" | "$BIN" bootstrap stage \
        --state-dir "$STATE_DIR" \
        --share "$share_name" \
        --type "$media_type" \
        --mode "$mode" \
        --tmdb-bearer-stdin
else
    "$BIN" bootstrap stage \
        --state-dir "$STATE_DIR" \
        --share "$share_name" \
        --type "$media_type" \
        --mode "$mode"
fi

chmod 600 "$BOOTSTRAP_FILE"
if [ "$(id -u)" = "0" ]; then
    chown sc-OCD "$BOOTSTRAP_FILE"
fi
